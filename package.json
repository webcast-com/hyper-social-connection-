    "@prisma/client": "^7.9.1",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.3.1",
    "lucide-react": "^1.24.0",
    "next": "16.2.6",
    "pg": "^8.20.0",
    "react": "19.2.6",
