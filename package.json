{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "prisma:dev": "prisma dev --name hyper-social-connection",
    "prisma:dev:stop": "prisma dev stop --name hyper-social-connection",
    "prisma:deploy": "npm run build && prisma deploy",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma contract emit",
    "db:plan": "prisma migration plan",
    "db:migrate": "prisma db migrate",
    "db:push": "prisma db update",
    "db:check": "prisma db verify",
    "db:seed": "tsx prisma/seed.ts",
    "db:verify": "tsx scripts/verify-prisma.ts",
    "db:local": "bash scripts/dev-db.sh start",
    "db:local:stop": "bash scripts/dev-db.sh stop",
    "db:local:status": "bash scripts/dev-db.sh status",
    "db:local:reset": "bash scripts/dev-db.sh reset",
    "storage:cors": "node scripts/s3-cors.mjs",
    "test:calls": "playwright test --config=playwright.calls.config.ts",
    "test:call-layout": "playwright test --config=playwright.call-layout.config.ts",
    "test:uploads": "playwright test --config=playwright.uploads.config.ts",
    "test:sports": "tsx --test tests/sports/*.test.ts",
    "test:sports-layout": "playwright test --config=playwright.sports.config.ts",
    "test:mobile-navigation": "playwright test --config=playwright.mobile-navigation.config.ts",
    "check:espn": "tsx scripts/check-espn.ts",
    "test:seo": "tsx --test tests/seo/*.test.ts",
    "test:theme": "tsx --test tests/theme/*.test.ts",
    "test:scorehub": "tsx --test tests/scorehub/*.test.ts",
    "predev": "node scripts/build-nfl-basketball.mjs",
    "prebuild": "node scripts/build-nfl-basketball.mjs",
    "build:nfl-basketball": "node scripts/build-nfl-basketball.mjs",
    "test:nfl-basketball": "tsx --test tests/nfl-basketball/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1118.0",
    "@aws-sdk/s3-request-presigner": "^3.1118.0",
    "@netlify/plugin-nextjs": "^5.15.13",
    "@prisma/composer": "0.38.0",
    "@prisma/composer-prisma-cloud": "0.38.0",
    "@prisma/orm-postgres": "8.0.0-rc.23",
    "@types/bcryptjs": "^2.4.6",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.3.1",
    "lucide-react": "^1.24.0",
    "next": "16.2.6",
    "pg": "^8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "^22.19.15",
    "@types/pg": "^8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "hyper-prisma-next-shim": "file:tools/prisma-next-shim",
    "jsdom": "^26.1.0",
    "postcss": "8.5.8",
    "prisma": "8.0.0-rc.33",
    "tailwindcss": "4.1.17",
    "tsx": "^4.23.12",
    "typescript": "5.9.3"
  }
}
