# ── Database ──────────────────────────────────────────────────────────────
# Any PostgreSQL connection string — see DATABASE.md for provider guides
# (Neon, Prisma Postgres, RDS, Railway, local, zero-Docker local via
# `npm run db:local`, …). When your provider offers pooled and direct
# endpoints, use the DIRECT one — the app runs DDL on boot.
DATABASE_URL=postgres://dbbfaefd39ef72f2482714a3dda86dff2b680db9b0865e8821eafe908ca9cae3:sk_Q60Xk3sYiOc61r6WoOZUG@pooled.db.prisma.io:5432/postgres?sslmode=require

# Only for local/self-hosted Postgres WITHOUT TLS:
# DATABASE_SSL=false

# ── Auth ──────────────────────────────────────────────────────────────────
# Authentication uses opaque, database-backed Prisma sessions. No auth secret
# is required; keep DATABASE_URL reachable so sessions can be created/read.

# ── Group video/audio calls ───────────────────────────────────────────────
# Group calls use native peer-to-peer WebRTC. The browser connects peers
# directly; Postgres is used only to relay signaling (who is in the call and
# SDP/ICE messages). No third-party provider or API key is required — nothing
# to configure here.
#
# For calls to work across most networks, an ICE/TURN server is recommended
# for NAT traversal. STUN-only is used by default; you can add TURN by
# overriding ICE servers in src/components/Call/WebRTCRoom.tsx if needed.

# ── Media / object storage ────────────────────────────────────────────────
# Optional. When set, uploads go to a Prisma Object Store bucket (or any
# S3-compatible store: R2, MinIO, AWS S3). Postgres still stores only the
# stable URL `/uploads/<uuid>.<ext>` — never a presigned link.
#
# Prisma Console → your project → Object Store → create a bucket → mint a
# read_write key. The key response maps 1:1 onto these variables
# (bucketName, endpoint, accessKeyId, secretAccessKey).
#
# Leave all of these unset for local-disk uploads under public/uploads.
 S3_ENDPOINT=https://t3.storage.dev
 S3_ACCESS_KEY_ID=tid__voYWwAAfOMqtfoTzKtABydOVbAixWRVarcQrNtrbjmamMnpUA
 S3_SECRET_ACCESS_KEY=tsec_BgPlKicIXJlQRM04cpx5SC3X_S7P+IlPPLRVxcr_R4xG37+dimV3-RsT9h1uEhBBOnneiP
 S3_BUCKET=user-uui967u6ewza2ss715uqohrt
 S3_REGION=auto
 S3_FORCE_PATH_STYLE=true
#
# Aliases accepted: PRISMA_BUCKET_NAME, PRISMA_BUCKET_ENDPOINT,
# PRISMA_BUCKET_ACCESS_KEY_ID, PRISMA_BUCKET_SECRET_ACCESS_KEY,
# PRISMA_BUCKET_REGION.
