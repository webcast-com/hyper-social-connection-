# Copy to .env.local and fill in your values.

# ── Postgres connection string (server-side query layer) ────────────────────
# Any PostgreSQL database works: Neon, Prisma Postgres, AWS RDS/Aurora,
# Railway, DigitalOcean, Render, Aiven, or a local/self-hosted Postgres.
# Format:
#   postgres://USER:PASSWORD@HOST:PORT/DATABASE
#
# Prisma Postgres: use the DIRECT string (db.prisma.io), not the pooled one,
# and append an explicit database name — the console gives you a URL ending
# in "/?sslmode=require", which has no database name and will fail:
#   postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require
# After setting it, create/sync the tables with:
#   npm run db:push
# Leave empty to run in demo/offline mode with mock data.
DATABASE_URL=

# TLS handling for the connection. The default (unset) uses TLS with relaxed
# certificate validation, which works for managed providers. Set to "false"
# for a local/self-hosted Postgres that has no TLS.
# DATABASE_SSL=false

# ── Optional ─────────────────────────────────────────────────────────────────
# Absolute URL of the deployed site (used for links/metadata).
# Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Secret used to sign session cookies (JWT). Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

# Next.js dev preview hosts (keep for Arena previews).
# ALLOWED_DEV_ORIGINS=
