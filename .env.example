# ── Database ──────────────────────────────────────────────────────────────
# Any PostgreSQL connection string — see DATABASE.md for provider guides
# (Neon, Prisma Postgres, RDS, Railway, local, zero-Docker local via
# `npm run db:local`, …). When your provider offers pooled and direct
# endpoints, use the DIRECT one — the app runs DDL on boot.
DATABASE_URL=postgres://user:password@host:5432/postgres

# Only for local/self-hosted Postgres WITHOUT TLS:
# DATABASE_SSL=false

# ── Auth ──────────────────────────────────────────────────────────────────
# Signs session cookies — generate with: openssl rand -base64 48
JWT_SECRET=change-me
