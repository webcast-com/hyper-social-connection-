// Prisma schema — the app's complete data model. Prisma is the ONLY ORM.
//
// Field names are camelCase (the shape the app code has always consumed) and
// @map to the physical snake_case columns, so the existing database is a
// byte-for-byte match — `prisma db push` against it is a no-op.
//
// Postgres-specific triggers/functions (post like & comment counters) live in
// src/lib/social-ddl.ts, applied as raw SQL on boot.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         Int       @id @default(autoincrement())
  name       String
  email      String    @unique
  password   String
  username   String?   @unique
  avatar     String?
  coverPhoto String?   @map("cover_photo")
  bio        String?
  location   String?
  website    String?
  pronouns   String?
  workplace  String?
  education  String?
  // Profile extras: shown on the profile page and used for discovery.
  // Plain columns (not enums) so the boot DDL in src/lib/migrate.ts stays the
  // single source of truth for the physical schema.
  age        Int       @default(18)
  gender     String    @default("male")
  relationship String  @default("single") @map("relationship_status")
  profileVisibility String @default("public") @map("profile_visibility")
  messagePrivacy    String @default("everyone") @map("message_privacy")
  followPrivacy     String @default("everyone") @map("follow_privacy")
  notifyLikes       Int    @default(1) @map("notify_likes")
  notifyComments    Int    @default(1) @map("notify_comments")
  notifyFollows     Int    @default(1) @map("notify_follows")
  notifyMessages    Int    @default(1) @map("notify_messages")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  posts               Post[]         @relation("PostAuthor")
  stories             Story[]
  adminGroups         Group[]        @relation("GroupAdmin")
  groupMemberships    GroupMember[]
  groupJoinRequests   GroupJoinRequest[]
  comments            Comment[]
  likes               Like[]
  followsGiven        Follow[]       @relation("FollowFollower")
  followsReceived     Follow[]       @relation("FollowFollowing")
  messagesSent        Message[]      @relation("MessageSender")
  messagesReceived    Message[]      @relation("MessageReceiver")
  notificationsReceived Notification[] @relation("NotificationUser")
  notificationsActed  Notification[] @relation("NotificationActor")
  bookmarks           Bookmark[]
  reports             Report[]         @relation("ReportReporter")
  reportsReceived     Report[]         @relation("ReportTarget")
  pollVotes           PollVote[]
  sessions            Session[]
  accounts            Account[]
  blocksGiven         Block[]          @relation("BlockBlocker")
  blocksReceived      Block[]          @relation("BlockBlocked")
  mutesGiven          Mute[]           @relation("MuteMuter")
  mutesReceived       Mute[]           @relation("MuteMuted")
  followRequestsSent      FollowRequest[] @relation("FollowRequestFrom")
  followRequestsReceived  FollowRequest[] @relation("FollowRequestTo")
  groupEventsCreated  GroupEvent[]
  eventRsvps          GroupEventRsvp[]
  groupCallsCreated   GroupCall[]

  @@map("users")
}

model Post {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  content      String
  imageUrl     String?   @map("image_url")
  videoUrl     String?   @map("video_url")
  privacy      String    @default("public")
  repostOfId   Int?      @map("repost_of_id")
  groupId      Int?      @map("group_id")
  likesCount   Int       @default(0) @map("likes_count")
  commentsCount Int      @default(0) @map("comments_count")
  scheduledAt  DateTime? @map("scheduled_at") @db.Timestamp(6)
  updatedAt    DateTime? @map("updated_at") @db.Timestamp(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  user          User          @relation("PostAuthor", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  group         Group?        @relation("PostGroup", fields: [groupId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  repostOf      Post?         @relation("PostRepost", fields: [repostOfId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  reposts       Post[]        @relation("PostRepost")
  comments      Comment[]
  likes         Like[]
  bookmarks     Bookmark[]
  reports       Report[]
  polls         Poll[]
  notifications Notification[]

  @@map("posts")
}

model Story {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  imageUrl  String   @map("image_url")
  expiresAt DateTime @map("expires_at") @db.Timestamp(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("stories")
}

model Group {
  id               Int      @id @default(autoincrement())
  name             String
  description      String?
  coverPhoto       String?  @map("cover_photo")
  adminId          Int      @map("admin_id")
  privacy          String   @default("public")
  category         String?
  rules            String?
  location         String?
  website          String?
  requireApproval  Int      @default(0) @map("require_approval")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  admin        User              @relation("GroupAdmin", fields: [adminId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  posts        Post[]            @relation("PostGroup")
  groupMembers GroupMember[]
  joinRequests GroupJoinRequest[]
  events       GroupEvent[]
  calls        GroupCall[]

  @@map("groups")
}

model GroupMember {
  groupId   Int      @map("group_id")
  userId    Int      @map("user_id")
  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([groupId, userId])
  @@map("group_members")
}

model GroupJoinRequest {
  id        Int      @id @default(autoincrement())
  groupId   Int      @map("group_id")
  userId    Int      @map("user_id")
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([groupId, userId])
  @@map("group_join_requests")
}

model Comment {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  userId    Int      @map("user_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("comments")
}

model Like {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([postId, userId], map: "likes_post_id_user_id_key")
  @@map("likes")
}

model Follow {
  followerId  Int      @map("follower_id")
  followingId Int      @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  follower  User @relation("FollowFollower", fields: [followerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  following User @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([followerId, followingId])
  @@map("follows")
}

model Message {
  id         Int      @id @default(autoincrement())
  senderId   Int      @map("sender_id")
  receiverId Int      @map("receiver_id")
  content    String
  imageUrl   String?  @map("image_url")
  videoUrl   String?  @map("video_url")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  sender        User          @relation("MessageSender", fields: [senderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receiver      User          @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  notifications Notification[]

  @@map("messages")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  actorId   Int      @map("actor_id")
  type      String
  postId    Int?     @map("post_id")
  messageId Int?     @map("message_id")
  isRead    Int      @default(0) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user    User     @relation("NotificationUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actor   User     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  message Message? @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("notifications")
}

model Bookmark {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  postId    Int      @map("post_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("bookmarks")
}

model Report {
  id             Int      @id @default(autoincrement())
  reporterId     Int      @map("reporter_id")
  postId         Int?     @map("post_id")
  reportedUserId Int?     @map("reported_user_id")
  reason         String
  details        String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  reporter     User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reportedUser User? @relation("ReportTarget", fields: [reportedUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  post         Post? @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("reports")
}

model Block {
  blockerId Int      @map("blocker_id")
  blockedId Int      @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  blocker User @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  blocked User @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([blockerId, blockedId])
  @@map("blocks")
}

model Mute {
  muterId   Int      @map("muter_id")
  mutedId   Int      @map("muted_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  muter User @relation("MuteMuter", fields: [muterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  muted User @relation("MuteMuted", fields: [mutedId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([muterId, mutedId])
  @@map("mutes")
}

model FollowRequest {
  id          Int      @id @default(autoincrement())
  followerId  Int      @map("follower_id")
  followingId Int      @map("following_id")
  status      String   @default("pending")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  follower  User @relation("FollowRequestFrom", fields: [followerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  following User @relation("FollowRequestTo", fields: [followingId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([followerId, followingId])
  @@map("follow_requests")
}

model GroupCall {
  id          Int      @id @default(autoincrement())
  groupId     Int      @map("group_id")
  creatorId   Int      @map("creator_id")
  title       String
  description String?
  // Native WebRTC room identifier ("webrtc://call/<uuid>") used to identify a
  // call in the signaling relay. No third-party provider is used.
  roomUrl     String   @map("room_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  creator User  @relation(fields: [creatorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([groupId, roomUrl])
  @@index([groupId, isActive])
  @@map("group_calls")
}

model GroupEvent {
  id          Int      @id @default(autoincrement())
  groupId     Int      @map("group_id")
  createdById Int      @map("created_by_id")
  title       String
  description String?
  location    String?
  startsAt    DateTime @map("starts_at") @db.Timestamp(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  group     Group            @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdBy User             @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rsvps     GroupEventRsvp[]

  @@map("group_events")
}

model GroupEventRsvp {
  eventId   Int      @map("event_id")
  userId    Int      @map("user_id")
  status    String   @default("going")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  event GroupEvent @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([eventId, userId])
  @@map("group_event_rsvps")
}

model Poll {
  id        Int       @id @default(autoincrement())
  postId    Int       @map("post_id")
  question  String?
  expiresAt DateTime? @map("expires_at") @db.Timestamp(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  post    Post         @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  options PollOption[]
  votes   PollVote[]

  @@map("polls")
}

model PollOption {
  id        Int      @id @default(autoincrement())
  pollId    Int      @map("poll_id")
  text      String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  poll  Poll        @relation(fields: [pollId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  votes PollVote[]

  @@map("poll_options")
}

model PollVote {
  id        Int      @id @default(autoincrement())
  pollId    Int      @map("poll_id")
  optionId  Int      @map("option_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  poll   Poll        @relation(fields: [pollId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  option PollOption  @relation(fields: [optionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("poll_votes")
}

// ─── Authentication (Auth.js-compatible) ─────────────────────────────────

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique @map("session_token")
  userId       Int      @map("user_id")
  expires      DateTime @db.Timestamp(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                 Int     @id @default(autoincrement())
  userId             Int     @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refreshToken       String? @map("refresh_token")
  accessToken        String? @map("access_token")
  expiresAt          Int?    @map("expires_at")
  tokenType          String? @map("token_type")
  scope              String?
  idToken            String? @map("id_token")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamp(6)

  @@id([identifier, token])
  @@map("verification_tokens")
}
