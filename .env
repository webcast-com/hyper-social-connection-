# ── Postgres connection string (any PostgreSQL database) ────────────────────
# Works with Neon, AWS RDS, Railway, DigitalOcean, Render, a local Postgres,
# or any other provider. Format:
#   postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Then create the tables: npm run db:push
# Leave empty to run in demo/offline mode with mock data.
DATABASE_URL=

# Set to "false" only for local/self-hosted Postgres without TLS support.
# Managed providers (Neon, RDS, Railway, …) work with the default.
# DATABASE_SSL=false

# ── Optional ─────────────────────────────────────────────────────────────────
# Absolute URL of the deployed site (used in generated links and metadata).
# Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://hyper-social-connection.vercel.app/

# Secret used to sign session cookies. Keep it private; change it to log
# everyone out.
JWT_SECRET=CO5PKnqQVFcUHmUsByq5t/RTjjPP4ptgbXxmR9tVTEOb+9GQxayLxipsKbMeaEsk

# Next.js dev preview hosts (keep for Arena previews).
# ALLOWED_DEV_ORIGINS=
