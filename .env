# ── Supabase project (Dashboard → Project Settings → API) ───────────────────
SUPABASE_URL=https://pjzhjzqzmajbastavmkd.supabase.co

# Public anon key (Dashboard → Project Settings → API → Project API keys → anon public)
# Setting SUPABASE_URL + SUPABASE_ANON_KEY together switches the app into
# full Supabase mode: Supabase Auth (email/password + Google/GitHub OAuth),
# storage uploads and realtime chat.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBqemhqenF6bWFqYmFzdGF2bWtkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQ5OTc0OTEsImV4cCI6MjEwMDU3MzQ5MX0.iTGgXDcJZqlNRCv5hh9lyFWs5Q5SHZRg-v78ttI7frQ

# Service role key (Dashboard → Project Settings → API → service_role).
# Optional but recommended: lets the server auto-create the storage bucket
# and upload media as an admin. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBqemhqenF6bWFqYmFzdGF2bWtkIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NDk5NzQ5MSwiZXhwIjoyMTAwNTczNDkxfQ.OIocIiZK4EbGyWYV5jZmKlK-2j37b0KIAgHtX1a_H-4

# Storage bucket used for post/avatar/story media (created automatically
# when the service role key is set, or by running supabase/storage.sql).
SUPABASE_STORAGE_BUCKET=uploads

# ── Postgres connection string (server-side query layer) ────────────────────
# Supabase Dashboard → Project Settings → Database → Connection string
# (Transaction pooler, port 6543). Format:
# postgres://postgres.<project-ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Then create the tables: npx drizzle-kit push
DATABASE_URL=postgres://postgres.pjzhjzqzmajbastavmkd:DdWQ2Osj91IINoC0@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true

